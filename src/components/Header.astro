---
import { categories, tools } from '../data/tools';

const normalize = (href: string) => href.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
const isCurrent = (href: string) => (normalize(href) === current ? 'page' : undefined);
---

<header class="site-header">
	<div class="container clean-nav">
		<a class="brand" href="/" aria-label="PDF AI home" aria-current={isCurrent('/')}><span class="brand-mark"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z"/><path fill="none" stroke="var(--ink)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M14 2v6h6"/></svg></span><span>PDF<span class="brand-accent">AI</span></span></a>
		<button class="nav-search-toggle" type="button" aria-label="Search PDF tools" aria-controls="main-nav" aria-expanded="false"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="7" cy="7" r="4.4"/><path d="m10.4 10.4 3.4 3.4"/></svg></button>
		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Open navigation menu"><span></span><span></span><span></span></button>
		<nav class="main-nav" id="main-nav" aria-label="PDF tool navigation">
			<div class="drawer-head">
				<span class="drawer-title">All PDF Tools</span>
				<button class="drawer-close" type="button" aria-label="Close navigation menu"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8"/></svg></button>
			</div>
			<div class="menu-cluster" data-menu-root>
				<label class="nav-search">
					<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.4"/><path d="m10.4 10.4 3.4 3.4"/></svg>
					<input type="search" id="tool-search" placeholder="Search" aria-label="Search PDF tools" autocomplete="off" spellcheck="false" />
				</label>
				<div class="all-tools-menu">
					<button class="nav-trigger" type="button" aria-expanded="false" aria-controls="tools-menu">All PDF Tools</button>
					<div class="menu" id="tools-menu" hidden>
						<div class="tools-groups">
							<a class="menu-heading" href="/#tools">Browse all PDF tools</a>
							{categories.map((category) => (
								<div class="all-tools-group" data-group>
									<strong>{category}</strong>
									{tools.filter((tool) => tool.category === category).map((tool) => {
										const href = `/${tool.slug}/`;
										return <a href={href} data-tool-link data-search={`${tool.name} ${tool.description} ${tool.category}`.toLowerCase()} aria-current={isCurrent(href)}>{tool.name}</a>;
									})}
								</div>
							))}
						</div>
						<p class="tools-empty" hidden>No tools match that search.</p>
					</div>
				</div>
			</div>
			<a class="nav-help" href="/help/" aria-current={isCurrent('/help')}>Help</a>
		</nav>
		<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
			<svg class="theme-icon theme-icon-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M14 9.6A6.2 6.2 0 0 1 6.4 2 6.2 6.2 0 1 0 14 9.6Z"/></svg>
			<svg class="theme-icon theme-icon-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3.1"/><path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1"/></svg>
		</button>
	</div>
</header>
<script>
	const qs = <T extends Element>(selector: string) => document.querySelector<T>(selector);

	const menuRoot = qs<HTMLElement>('[data-menu-root]');
	const trigger = qs<HTMLButtonElement>('.nav-trigger');
	const panel = qs<HTMLDivElement>('#tools-menu');
	const search = qs<HTMLInputElement>('#tool-search');
	const nav = qs<HTMLElement>('#main-nav');
	const navToggle = qs<HTMLButtonElement>('.nav-toggle');
	const searchToggle = qs<HTMLButtonElement>('.nav-search-toggle');
	const drawerClose = qs<HTMLButtonElement>('.drawer-close');
	const empty = qs<HTMLElement>('.tools-empty');
	const heading = qs<HTMLAnchorElement>('.menu-heading');
	const themeToggle = qs<HTMLButtonElement>('[data-theme-toggle]');
	const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
	const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-tool-link]')].map((link) => ({
		link,
		group: link.closest<HTMLElement>('[data-group]')
	}));

	if (menuRoot && trigger && panel && search && nav && navToggle && drawerClose && empty && heading) {
		const mobileQuery = matchMedia('(max-width: 640px)');
		let menuOpen = false;
		let drawerOpen = false;
		let leaveTimer = 0;

		const applyFilter = (raw: string) => {
			const query = raw.trim().toLowerCase();
			let matches = 0;
			for (const group of groups) {
				let shown = 0;
				for (const item of items) {
					if (item.group !== group) continue;
					const hit = !query || (item.link.dataset.search ?? '').includes(query);
					item.link.hidden = !hit;
					if (hit) shown++;
				}
				group.hidden = shown === 0;
				matches += shown;
			}
			empty.hidden = matches !== 0;
			heading.hidden = query.length > 0;
		};

		const visibleLinks = () => items.filter((item) => !item.link.hidden && item.group && !item.group.hidden).map((item) => item.link);

		const renderMenu = () => {
			panel.hidden = !(menuOpen || mobileQuery.matches);
			trigger.setAttribute('aria-expanded', String(menuOpen));
		};

		const openMenu = () => {
			if (mobileQuery.matches) return;
			window.clearTimeout(leaveTimer);
			menuOpen = true;
			renderMenu();
			applyFilter(search.value);
		};

		const closeMenu = (focusTrigger = false) => {
			window.clearTimeout(leaveTimer);
			menuOpen = false;
			renderMenu();
			search.value = '';
			applyFilter('');
			if (focusTrigger) trigger.focus();
		};

		const openDrawer = () => {
			if (drawerOpen) return;
			drawerOpen = true;
			document.body.classList.add('drawer-open');
			navToggle.setAttribute('aria-expanded', 'true');
			searchToggle?.setAttribute('aria-expanded', 'true');
			drawerClose.focus();
		};

		const closeDrawer = (focusToggle = false) => {
			if (!drawerOpen) return;
			drawerOpen = false;
			document.body.classList.remove('drawer-open');
			navToggle.setAttribute('aria-expanded', 'false');
			searchToggle?.setAttribute('aria-expanded', 'false');
			if (focusToggle) navToggle.focus();
		};

		renderMenu();

		trigger.addEventListener('click', () => (menuOpen ? closeMenu() : openMenu()));

		menuRoot.addEventListener('pointerenter', (event) => {
			if (event.pointerType !== 'mouse') return;
			openMenu();
		});

		menuRoot.addEventListener('pointerleave', (event) => {
			if (event.pointerType !== 'mouse' || menuRoot.matches(':focus-within')) return;
			window.clearTimeout(leaveTimer);
			leaveTimer = window.setTimeout(() => {
				if (!menuRoot.matches(':focus-within')) closeMenu();
			}, 180);
		});

		menuRoot.addEventListener('focusout', () => {
			window.setTimeout(() => {
				if (!menuRoot.contains(document.activeElement)) closeMenu();
			}, 0);
		});

		document.addEventListener('pointerdown', (event) => {
			const target = event.target as Node;
			if (menuOpen && !menuRoot.contains(target)) closeMenu();
			if (drawerOpen && !nav.contains(target) && !navToggle.contains(target)) closeDrawer();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			if (drawerOpen) {
				closeDrawer(true);
				return;
			}
			if (menuOpen) closeMenu(true);
		});

		search.addEventListener('focus', openMenu);

		search.addEventListener('input', () => applyFilter(search.value));

		search.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				event.stopPropagation();
				if (search.value) {
					search.value = '';
					applyFilter('');
					return;
				}
				if (mobileQuery.matches) closeDrawer(true);
				else closeMenu(true);
				return;
			}
			const hits = visibleLinks();
			if (event.key === 'ArrowDown') {
				if (hits[0]) {
					event.preventDefault();
					hits[0].focus();
				}
				return;
			}
			if (event.key === 'Enter' && hits.length > 0) {
				event.preventDefault();
				if (hits.length === 1) hits[0].click();
				else hits[0].focus();
			}
		});

		nav.addEventListener('click', (event) => {
			const link = (event.target as Element | null)?.closest('a');
			if (!link) return;
			closeMenu();
			closeDrawer();
		});

		navToggle.addEventListener('click', () => (drawerOpen ? closeDrawer(true) : openDrawer()));
		drawerClose.addEventListener('click', () => closeDrawer(true));
		searchToggle?.addEventListener('click', () => {
			openDrawer();
			// openDrawer() focuses the close button first; hand focus to the search field.
			window.setTimeout(() => search.focus(), 60);
		});

		mobileQuery.addEventListener('change', () => {
			menuOpen = false;
			search.value = '';
			closeDrawer();
			renderMenu();
			applyFilter('');
		});

		if (themeToggle) {
			const root = document.documentElement;
			const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
			const supportsViewTransition = typeof document.startViewTransition === 'function';
			const syncLabel = () => themeToggle.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
			syncLabel();

			let iconTimer = 0;
			let fadeTimer = 0;

			const popIcon = () => {
				themeToggle.classList.remove('is-toggling');
				void themeToggle.offsetWidth; // restart the animation
				themeToggle.classList.add('is-toggling');
				window.clearTimeout(iconTimer);
				iconTimer = window.setTimeout(() => themeToggle.classList.remove('is-toggling'), 600);
			};

			const applyTheme = (next: string) => {
				root.dataset.theme = next;
				try {
					localStorage.setItem('theme', next);
				} catch {}
				syncLabel();
			};

			// Crossfade fallback for browsers without the View Transitions API.
			const fadeColors = () => {
				root.classList.remove('theme-animating');
				void root.offsetWidth;
				root.classList.add('theme-animating');
				window.clearTimeout(fadeTimer);
				fadeTimer = window.setTimeout(() => root.classList.remove('theme-animating'), 550);
			};

			themeToggle.addEventListener('click', () => {
				const next = root.dataset.theme === 'dark' ? 'light' : 'dark';

				if (reduceMotion.matches || !supportsViewTransition) {
					applyTheme(next);
					if (!reduceMotion.matches) {
						fadeColors();
						popIcon();
					}
					return;
				}

				// Expand the new theme outwards from the toggle button.
				const rect = themeToggle.getBoundingClientRect();
				const x = rect.left + rect.width / 2;
				const y = rect.top + rect.height / 2;
				const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
				root.style.setProperty('--theme-reveal-x', `${x}px`);
				root.style.setProperty('--theme-reveal-y', `${y}px`);
				root.style.setProperty('--theme-reveal-r', `${radius}px`);

				document.startViewTransition(() => {
					applyTheme(next);
					popIcon();
				});
			});
		}
	}
</script>
