---
import '../styles/global.css';
import '../styles/editor.css';
import SEO from '../components/SEO.astro';

const title = 'Free PDF Editor — Edit PDF Online Without Signup | PDF AI';
const description =
	'Edit PDF files online free in your browser. Add text, draw, highlight, redact, sign, crop and rearrange pages — no signup, no uploads, no software.';
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		name: 'PDF AI Free PDF Editor',
		url: 'https://pdfai.site/editor/',
		description,
		applicationCategory: 'GraphicsApplication',
		operatingSystem: 'Any',
		isAccessibleForFree: true,
		inLanguage: 'en',
	},
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<SEO title={title} description={description} canonicalURL="https://pdfai.site/editor/" jsonLd={jsonLd} />
<link rel="icon" href="/favicon.svg" />
<script is:inline>(function(){try{var t=localStorage.getItem('theme');if(t!=='dark'&&t!=='light'){t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}document.documentElement.dataset.theme=t;}catch(e){document.documentElement.dataset.theme='light';}})();</script>
</head>
<body class="editor-body">
<div class="editor-app is-empty" id="editor-app">

	<!-- Top bar -->
	<header class="ed-topbar">
		<a class="ed-brand" href="/" aria-label="PDF AI home">
			<span class="ed-brand-mark"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z"/><path fill="none" stroke="var(--ink)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M14 2v6h6"/></svg></span>
			<span>PDF<span class="ed-brand-accent">AI</span></span>
			<span class="ed-brand-sub">Editor</span>
		</a>

		<div class="ed-doc" id="ed-doc">
			<span class="ed-doc-name" id="ed-doc-name">No file open</span>
			<span class="ed-doc-meta" id="ed-doc-meta"></span>
		</div>

		<div class="ed-topbar-actions">
			<button class="ed-btn ed-icon-btn" id="ed-theme" type="button" title="Switch to dark mode" aria-label="Switch to dark mode">
				<svg class="theme-icon theme-icon-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M14 9.6A6.2 6.2 0 0 1 6.4 2 6.2 6.2 0 1 0 14 9.6Z"/></svg>
				<svg class="theme-icon theme-icon-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3.1"/><path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1"/></svg>
			</button>
			<button class="ed-btn" id="ed-open" type="button">Open PDF</button>
			<button class="ed-btn" id="ed-undo" type="button" disabled title="Undo (Ctrl+Z)">Undo</button>
			<button class="ed-btn" id="ed-redo" type="button" disabled title="Redo (Ctrl+Y)">Redo</button>
			<button class="ed-btn ed-btn-primary" id="ed-download" type="button" disabled>Download</button>
		</div>
	</header>

	<!-- Workspace: always visible so the empty state can greet the user -->
	<div class="ed-workspace" id="ed-workspace">
		<!-- Left: modes + thumbnails -->
		<aside class="ed-sidebar">
			<nav class="ed-modes" aria-label="Editor modes">
				<button class="ed-mode is-active" data-mode="edit" type="button">
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 3.5 16.5 6.5 7 16H4v-3z"/></svg>
					<span>Edit</span>
				</button>
				<button class="ed-mode" data-mode="organize" type="button">
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="6" height="6" rx="1"/><rect x="11" y="3" width="6" height="6" rx="1"/><rect x="3" y="11" width="6" height="6" rx="1"/><rect x="11" y="11" width="6" height="6" rx="1"/></svg>
					<span>Organize</span>
				</button>
				<button class="ed-mode" data-mode="pages" type="button">
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2.5h6l4 4v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-14a1 1 0 0 1 1-1z"/><path d="M11 2.5v4h4"/></svg>
					<span>Pages</span>
				</button>
			</nav>
			<div class="ed-thumbs" id="ed-thumbs" role="listbox" aria-label="Page thumbnails" tabindex="0"></div>
			<div class="ed-sidebar-foot" id="ed-sidebar-foot"></div>
		</aside>

		<!-- Center: toolbar + canvas -->
		<main class="ed-stage">
			<div class="ed-toolbar" id="ed-toolbar" role="toolbar" aria-label="Editing tools">
				<button class="ed-tool is-active" data-tool="select" type="button" title="Select / Move"><svg viewBox="0 0 20 20" width="17" height="17" fill="currentColor"><path d="M5 2.5 15 10l-4.2.9 2.3 4.4-2 1-2.3-4.4L5 15.5z"/></svg><span>Select</span></button>
				<span class="ed-tool-sep" aria-hidden="true"></span>
				<button class="ed-tool" data-tool="edittext" type="button" title="Edit existing text"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5V3.5h9V5"/><path d="M7.5 3.5v13M5.5 16.5h4"/><path d="M13 8.5h4M15 8.5v8M13.5 16.5h3"/></svg><span>Edit Text</span></button>
				<button class="ed-tool" data-tool="addtext" type="button" title="Add text"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 5V3.5h12V5"/><path d="M10 3.5v13M8 16.5h4"/></svg><span>Add Text</span></button>
				<button class="ed-tool" data-tool="draw" type="button" title="Draw freehand"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 3.2 16.8 6.5 7.5 15.8l-4 .7.7-4z"/></svg><span>Draw</span></button>
				<button class="ed-tool" data-tool="eraser" type="button" title="Eraser — click anything you added to remove it"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 16.5H16"/><path d="m4.8 13.2 5.9-5.9a1.7 1.7 0 0 1 2.4 0l3.1 3.1a1.7 1.7 0 0 1 0 2.4L12.9 16.5H7.4l-2.6-2.6a1 1 0 0 1 0-1.7Z"/><path d="m8.6 8.9 4.5 4.5"/></svg><span>Eraser</span></button>
				<button class="ed-tool" data-tool="highlight" type="button" title="Highlight"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 12.5 4l3.5 3.5L7.5 16H4z"/><path d="M3 18h6"/></svg><span>Highlight</span></button>
				<button class="ed-tool" data-tool="shape" type="button" title="Shape — drag to draw it, then drag the shape or its corner handles to move or resize it"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="3.5" width="13" height="13" rx="1.5"/></svg><span>Shape</span></button>
				<button class="ed-tool" data-tool="redact" type="button" title="Redact"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="3.5" y="6.5" width="13" height="7" rx="1"/><path d="M6 8.5h8M6 11.5h5"/></svg><span>Redact</span></button>
				<button class="ed-tool" data-tool="image" type="button" title="Insert image — added with the button below, not by clicking"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="14" height="11" rx="1.5"/><circle cx="7.5" cy="8.5" r="1.2"/><path d="m4 13 3.5-3 3 2.5L14 9l3 3.5"/></svg><span>Image</span></button>
				<button class="ed-tool" data-tool="sign" type="button" title="Signature"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13c3 0 4-7 6-7s2 7 4 7 2-3 4-3"/></svg><span>Sign</span></button>
				<span class="ed-tool-sep" aria-hidden="true"></span>
				<button class="ed-tool" data-tool="watermark" type="button" title="Watermark all pages"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5 10 3l7 3.5-7 3.5z"/><path d="M3 11.5 10 15l7-3.5"/></svg><span>Watermark</span></button>
				<button class="ed-tool" data-tool="crop" type="button" title="Crop page"><svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 2v12.5H18"/><path d="M2 5.5h12.5V18"/></svg><span>Crop</span></button>
			</div>

			<!-- Contextual options bar -->
			<div class="ed-options" id="ed-options" aria-live="polite"></div>

			<!-- Canvas viewport -->
			<div class="ed-viewport" id="ed-viewport">
				<div class="ed-canvas-wrap" id="ed-canvas-wrap">
					<canvas class="ed-canvas" id="ed-canvas"></canvas>
					<div class="ed-overlay" id="ed-overlay"></div>
					<div class="ed-crop-mask" id="ed-crop-mask" hidden></div>
					<div class="ed-selbar" id="ed-selbar" hidden></div>
				</div>
				<div class="ed-empty" id="ed-empty">
					<svg viewBox="0 0 24 24" width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
					<h1>Free PDF editor — open a PDF to start</h1>
					<p>Click the button below, or drag and drop a PDF anywhere on this page. Add text, draw, highlight, sign, crop and rearrange pages.</p>
					<button class="ed-btn ed-btn-primary ed-btn-lg" id="ed-open-empty" type="button">Open a PDF</button>
					<span class="ed-empty-hint">Everything runs in this browser tab — your file is never uploaded.</span>
					<span class="ed-empty-hint">Looking for something else? <a href="/#tools">Browse all free PDF tools</a>.</span>
				</div>
			</div>

			<!-- Bottom floating bar -->
			<div class="ed-bottombar" id="ed-bottombar" hidden>
				<button class="ed-nav" id="ed-prev" type="button" aria-label="Previous page">‹</button>
				<span class="ed-pageind"><input id="ed-pageinput" type="number" min="1" value="1" aria-label="Current page" /> / <span id="ed-pagecount">1</span></span>
				<button class="ed-nav" id="ed-next" type="button" aria-label="Next page">›</button>
				<span class="ed-zoomsep" aria-hidden="true"></span>
				<button class="ed-nav" id="ed-zoomout" type="button" aria-label="Zoom out">−</button>
				<span class="ed-zoomval" id="ed-zoomval">100%</span>
				<button class="ed-nav" id="ed-zoomin" type="button" aria-label="Zoom in">+</button>
				<button class="ed-nav ed-nav-wide" id="ed-zoomfit" type="button">Fit</button>
			</div>
		</main>

		<!-- Right panel (organize/pages context) -->
		<aside class="ed-panel" id="ed-panel" hidden></aside>
	</div>

	<!-- Signature modal -->
	<div class="ed-modal" id="ed-sigmodal" hidden>
		<div class="ed-modal-box" role="dialog" aria-modal="true" aria-labelledby="ed-sigtitle">
			<h2 id="ed-sigtitle">Create your signature</h2>
			<div class="ed-sig-tabs">
				<button class="ed-sig-tab is-active" data-sigtab="draw" type="button">Draw</button>
				<button class="ed-sig-tab" data-sigtab="type" type="button">Type</button>
			</div>
			<div class="ed-sig-draw" id="ed-sigdraw">
				<canvas id="ed-sigcanvas" width="460" height="160"></canvas>
				<button class="ed-btn" id="ed-sigclear" type="button">Clear</button>
			</div>
			<div class="ed-sig-type" id="ed-sigtype" hidden>
				<input id="ed-sigtext" type="text" placeholder="Type your name" autocomplete="off" />
				<div class="ed-sig-preview" id="ed-sigpreview">Your Name</div>
			</div>
			<div class="ed-modal-actions">
				<button class="ed-btn" id="ed-sigcancel" type="button">Cancel</button>
				<button class="ed-btn ed-btn-primary" id="ed-sigadd" type="button">Add signature</button>
			</div>
		</div>
	</div>

	<input type="file" id="ed-file" accept="application/pdf,.pdf" hidden />
	<input type="file" id="ed-imagefile" accept="image/*" hidden />
	<input type="file" id="ed-mergefile" accept="application/pdf,.pdf" multiple hidden />
	<div class="ed-dropoverlay" id="ed-dropoverlay" hidden><span>Drop your PDF to open it</span></div>
	<div class="ed-toast" id="ed-toast" role="status" aria-live="polite" hidden></div>
</div>
<script>import '../scripts/pdf-editor';</script>
</body>
</html>
